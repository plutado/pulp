{
  "formatVersion": 1,
  "id": "pulp.samples.atom",
  "name": "Atom",
  "description": "A nucleus with three electron orbits, drawing itself on.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "science-objects",
  "themes": [
    "science",
    "technology"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "science"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "orbit",
      "type": "color",
      "label": "Orbit color",
      "default": "#60a5fa",
      "element": "Colors"
    },
    {
      "id": "nucleus",
      "type": "color",
      "label": "Nucleus color",
      "default": "#f97316",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "draw",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
