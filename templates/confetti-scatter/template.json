{
  "formatVersion": 1,
  "id": "pulp.samples.confetti-scatter",
  "name": "Confetti scatter",
  "description": "Confetti scattered and held still: small rotated pieces in three colours over a flat ground; the scale sets their size and the angle turns the scatter.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "birthday",
    "new-year",
    "graduation"
  ],
  "styles": [
    "playful"
  ],
  "tags": [
    "still",
    "confetti",
    "party"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "base",
      "type": "color",
      "label": "Ground color",
      "default": "#0b1026",
      "element": "Colors"
    },
    {
      "id": "c1",
      "type": "color",
      "label": "First color",
      "default": "#f72585",
      "element": "Colors"
    },
    {
      "id": "c2",
      "type": "color",
      "label": "Second color",
      "default": "#4cc9f0",
      "element": "Colors"
    },
    {
      "id": "c3",
      "type": "color",
      "label": "Third color",
      "default": "#ffd60a",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.05,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
