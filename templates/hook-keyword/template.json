{
  "formatVersion": 1,
  "id": "pulp.samples.hook-keyword",
  "name": "Hook Keyword",
  "description": "A headline across the top third of a tall frame with one word picked out by a marker that sweeps behind it. Name the word in Keyword; any word of the headline will do.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "title",
  "tags": [
    "hook",
    "made-for-vertical",
    "highlight",
    "headline",
    "short-form"
  ],
  "themes": [
    "social-media",
    "education",
    "business"
  ],
  "styles": [
    "high-energy",
    "clean"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 1.2,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "9:16"
  ],
  "alpha": true,
  "entry": "index.html",
  "blocks": [
    {
      "id": "hook",
      "label": "Hook",
      "box": {
        "default": {
          "x": 0.1,
          "y": 0.15,
          "width": 0.8,
          "height": 0.2
        }
      },
      "gap": 0.012,
      "align": "center",
      "verticalAlign": "top",
      "typography": {
        "family": "Montserrat",
        "size": 0.09,
        "weight": 800,
        "color": "#ffffff",
        "align": "center",
        "lineHeight": 1.12,
        "maxLines": 3
      },
      "layers": [
        {
          "id": "headline",
          "type": "text",
          "label": "Headline",
          "text": "The one habit that changed everything",
          "required": true,
          "look": {
            "shadowColor": "#000000a6",
            "shadowDistance": 0.004,
            "shadowSoftness": 0.014
          }
        }
      ]
    }
  ],
  "parameters": [
    {
      "id": "keyword",
      "type": "text",
      "label": "Keyword",
      "default": "habit",
      "element": "Marker"
    },
    {
      "id": "marker",
      "type": "color",
      "label": "Marker",
      "default": "#facc15",
      "element": "Marker"
    },
    {
      "id": "markerInk",
      "type": "color",
      "label": "Word on the marker",
      "default": "#111827",
      "element": "Marker"
    }
  ]
}
