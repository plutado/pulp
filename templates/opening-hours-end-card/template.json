{
  "formatVersion": 1,
  "id": "pulp.samples.opening-hours-end-card",
  "name": "Find Us",
  "description": "A slate board with the address and the week’s opening hours sliding into their rows. Closes a shop tour, a menu reveal or a local spotlight.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "end-card",
  "tags": [
    "end card",
    "hours",
    "shop"
  ],
  "themes": [
    "food",
    "business",
    "community"
  ],
  "styles": [
    "clean",
    "organic"
  ],
  "duration": 7,
  "structure": {
    "holdFrom": 2.0,
    "holdTo": 6.0
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name2",
      "type": "text",
      "label": "Name",
      "default": "Fern & Fig",
      "maxLength": 26,
      "element": "Board"
    },
    {
      "id": "r1",
      "type": "text",
      "label": "Row one",
      "default": "12 Garden Lane, Millbrook",
      "maxLength": 40,
      "element": "Board"
    },
    {
      "id": "r2",
      "type": "text",
      "label": "Row two",
      "default": "tue–sat · 8.00 – 16.00",
      "maxLength": 36,
      "element": "Board"
    },
    {
      "id": "back",
      "type": "color",
      "label": "Background",
      "default": "#e9e4da",
      "element": "Scene"
    },
    {
      "id": "board",
      "type": "color",
      "label": "Board",
      "default": "#243530",
      "element": "Board"
    }
  ]
}
