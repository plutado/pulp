{
  "formatVersion": 1,
  "id": "pulp.samples.diagonal-bands",
  "name": "Diagonal bands",
  "description": "Wide diagonal bands in three colours of unequal widths with soft edges; the angle sets their slant and the scale their width.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "sports",
    "corporate"
  ],
  "styles": [
    "high-energy",
    "corporate"
  ],
  "tags": [
    "still",
    "bands",
    "stripes"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "c1",
      "type": "color",
      "label": "First band",
      "default": "#0f172a",
      "element": "Colors"
    },
    {
      "id": "c2",
      "type": "color",
      "label": "Second band",
      "default": "#1e40af",
      "element": "Colors"
    },
    {
      "id": "c3",
      "type": "color",
      "label": "Third band",
      "default": "#e11d48",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 25,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.08,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
