{
  "formatVersion": 1,
  "id": "pulp.samples.smoke-puffs",
  "name": "Smoke puffs",
  "description": "Round puffs of smoke billowing out in turn and drifting apart, as from a stack; loops.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "smoke",
  "themes": [
    "city",
    "travel"
  ],
  "styles": [
    "retro"
  ],
  "tags": [
    "effect",
    "smoke",
    "puff"
  ],
  "duration": 4,
  "fps": 30,
  "structure": {
    "loop": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "color",
      "type": "color",
      "label": "Color",
      "default": "#b9c0c8",
      "element": "Color"
    },
    {
      "id": "speed",
      "type": "number",
      "label": "Speed",
      "default": 1,
      "min": 0.25,
      "max": 3,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "density",
      "type": "number",
      "label": "Density",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.05,
      "element": "Motion"
    }
  ]
}
