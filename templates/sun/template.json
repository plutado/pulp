{
  "formatVersion": 1,
  "id": "pulp.samples.sun",
  "name": "Sun",
  "description": "A sun with twelve rays, popping in.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "nature-objects",
  "themes": [
    "summer",
    "weather"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "nature"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "sun",
      "type": "color",
      "label": "Sun color",
      "default": "#fbbf24",
      "element": "Colors"
    },
    {
      "id": "rays",
      "type": "color",
      "label": "Ray color",
      "default": "#f59e0b",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "pop",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
