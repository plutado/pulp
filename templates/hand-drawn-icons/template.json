{
  "formatVersion": 1,
  "id": "pulp.samples.hand-drawn-icons",
  "name": "Hand-drawn icons",
  "description": "A marker-style icon scribbled in stroke by stroke with a wobbly, boiling line and a loose circle scrawled round it.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "icons",
  "themes": ["education", "kids", "family"],
  "styles": ["hand-drawn"],
  "tags": ["icon", "marker", "doodle"],
  "duration": 5,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "icon", "type": "select", "label": "Icon", "default": "star",
      "options": [
        { "value": "check", "label": "Check" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "lightbulb", "label": "Light bulb" }
      ]
    },
    { "id": "stroke", "type": "color", "label": "Marker color", "default": "#2b6cb0", "group": "Colors" },
    { "id": "ring", "type": "color", "label": "Circle color", "default": "#f6ad55", "group": "Colors" },
    { "id": "weight", "type": "number", "label": "Marker weight", "default": 14, "min": 4, "max": 30, "step": 1 },
    { "id": "wobble", "type": "number", "label": "Wobble", "default": 50, "min": 0, "max": 100, "step": 5 },
    { "id": "size", "type": "number", "label": "Size (% of frame)", "default": 45, "min": 15, "max": 80, "step": 5 },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 1, "min": 0.3, "max": 2.5, "step": 0.1 }
  ]
}
