{
  "formatVersion": 1,
  "id": "pulp.samples.ripple-rings",
  "name": "Ripple rings",
  "description": "Rings spreading on a still surface where drops keep landing; loops.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "liquid",
  "themes": [
    "ocean",
    "nature"
  ],
  "styles": [
    "organic",
    "clean"
  ],
  "tags": [
    "effect",
    "ripple",
    "water"
  ],
  "duration": 4,
  "fps": 30,
  "structure": {
    "loop": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "color",
      "type": "color",
      "label": "Color",
      "default": "#7fc7ff",
      "element": "Color"
    },
    {
      "id": "speed",
      "type": "number",
      "label": "Speed",
      "default": 1,
      "min": 0.25,
      "max": 3,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "density",
      "type": "number",
      "label": "Density",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.05,
      "element": "Motion"
    }
  ]
}
