{
  "formatVersion": 1,
  "id": "pulp.samples.studio-sweep",
  "name": "Studio sweep",
  "description": "A photographer’s cyclorama: backdrop curving into floor under a soft overhead light; the angle moves the light and the scale its spread.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "corporate",
    "podcast"
  ],
  "styles": [
    "clean",
    "corporate"
  ],
  "tags": [
    "still",
    "studio",
    "cyclorama"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "back",
      "type": "color",
      "label": "Backdrop color",
      "default": "#2a2f3a",
      "element": "Colors"
    },
    {
      "id": "floor",
      "type": "color",
      "label": "Floor color",
      "default": "#11141b",
      "element": "Colors"
    },
    {
      "id": "light",
      "type": "color",
      "label": "Light color",
      "default": "#f1f5f9",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.12,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
