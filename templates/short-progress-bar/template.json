{
  "formatVersion": 1,
  "id": "pulp.samples.short-progress-bar",
  "name": "Progress Bar Top",
  "description": "A thin bar along the top edge of a tall frame that fills over the whole video, however long it is asked to run: how far through it the viewer is. No words; nothing that sits under the apps' own controls.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "overlay",
  "tags": [
    "made-for-vertical",
    "short-form",
    "progress",
    "bar"
  ],
  "themes": [
    "social-media",
    "education",
    "fitness"
  ],
  "styles": [
    "clean"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "9:16"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "fill",
      "type": "color",
      "label": "Bar",
      "default": "#facc15",
      "element": "Bar"
    },
    {
      "id": "track",
      "type": "color",
      "label": "Track",
      "default": "#ffffff40",
      "element": "Bar"
    },
    {
      "id": "thickness",
      "type": "number",
      "label": "Thickness",
      "default": 0.008,
      "min": 0.003,
      "max": 0.02,
      "step": 0.001,
      "element": "Bar"
    }
  ]
}
