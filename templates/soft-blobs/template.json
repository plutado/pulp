{
  "formatVersion": 1,
  "id": "pulp.samples.soft-blobs",
  "name": "Soft blobs",
  "description": "A few rounded pastel blobs drift and breathe across the frame at partial alpha, growing in and melting away.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "shapes",
  "themes": ["nature", "fashion", "family", "nonprofit"],
  "styles": ["organic"],
  "tags": ["blob", "pastel", "soft"],
  "duration": 8,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "color1", "type": "color", "label": "Blob color 1", "default": "#f9c6d0b3", "group": "Colors" },
    { "id": "color2", "type": "color", "label": "Blob color 2", "default": "#c8e7d4b3", "group": "Colors" },
    { "id": "color3", "type": "color", "label": "Blob color 3", "default": "#fde9b8b3", "group": "Colors" },
    { "id": "amount", "type": "number", "label": "Blobs", "default": 4, "min": 3, "max": 4, "step": 1 },
    { "id": "softness", "type": "number", "label": "Softness", "default": 60, "min": 0, "max": 100, "step": 5 },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 1.5, "min": 0.3, "max": 3, "step": 0.1 }
  ]
}
