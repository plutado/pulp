{
  "formatVersion": 1,
  "id": "pulp.samples.sunburst-rays",
  "name": "Sunburst rays",
  "description": "Alternating rays from a center set by the angle, the retro sunburst, under a soft vignette; the scale sets how many rays.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "concert",
    "summer"
  ],
  "styles": [
    "retro",
    "high-energy"
  ],
  "tags": [
    "still",
    "sunburst",
    "rays"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "c1",
      "type": "color",
      "label": "Ray color",
      "default": "#f4a261",
      "element": "Colors"
    },
    {
      "id": "c2",
      "type": "color",
      "label": "Gap color",
      "default": "#e76f51",
      "element": "Colors"
    },
    {
      "id": "edge",
      "type": "color",
      "label": "Edge color",
      "default": "#264653",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.12,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
