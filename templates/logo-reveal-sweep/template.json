{
  "formatVersion": 1,
  "id": "pulp.samples.logo-reveal-sweep",
  "name": "Light sweep logo reveal",
  "description": "The logo arrives from darkness as a soft diagonal band of light sweeps across it with a faint bloom, a tagline rises beneath, and a quicker second sweep crosses on the hold.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "logo-reveal",
  "themes": ["cinema", "concert", "gaming"],
  "styles": ["cinematic"],
  "tags": ["logo", "reveal", "light"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "name", "type": "text", "label": "Name", "default": "Northwind", "maxLength": 40, "description": "Set in type where the logo would be when no logo is chosen." },
    { "id": "tagline", "type": "text", "label": "Tagline", "default": "A Northwind Pictures release", "maxLength": 80 },
    { "id": "ground", "type": "color", "label": "Ground", "default": "#05060aff", "description": "Alpha 00 for a transparent ground.", "group": "Colors" },
    { "id": "light", "type": "color", "label": "Light color", "default": "#ffe9c2", "group": "Colors" },
    { "id": "glow", "type": "color", "label": "Glow color", "default": "#ff9a3c", "group": "Colors" },
    { "id": "ink", "type": "color", "label": "Text color", "default": "#f3efe8", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Sweep in / fade out (seconds)", "default": 1.4, "min": 0.6, "max": 2.5, "step": 0.1 },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "Lit by the sweep in the middle of the frame; falls back to the name.",
      "box": {
        "16:9": { "x": 0.36, "y": 0.32, "width": 0.28, "height": 0.3 },
        "9:16": { "x": 0.2, "y": 0.39, "width": 0.6, "height": 0.16 },
        "1:1": { "x": 0.25, "y": 0.34, "width": 0.5, "height": 0.26 },
        "4:5": { "x": 0.25, "y": 0.36, "width": 0.5, "height": 0.22 }
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name"
    }
  ]
}
