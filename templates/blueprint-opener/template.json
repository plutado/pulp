{
  "formatVersion": 1,
  "id": "pulp.samples.blueprint-opener",
  "name": "Blueprint",
  "description": "A blueprint grid that draws itself, corner marks and all, before the project name is stamped on. Opens builds, workshops and maker logs.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "opener",
  "tags": [
    "opener",
    "blueprint",
    "maker"
  ],
  "themes": [
    "technology",
    "science",
    "education"
  ],
  "styles": [
    "tech",
    "clean"
  ],
  "duration": 6,
  "structure": {
    "holdFrom": 1.4,
    "holdTo": 5.2
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "title",
      "type": "text",
      "label": "Project",
      "default": "Workbench 03",
      "maxLength": 28,
      "element": "Words"
    },
    {
      "id": "paper",
      "type": "color",
      "label": "Paper",
      "default": "#17365c",
      "element": "Sheet"
    },
    {
      "id": "line",
      "type": "color",
      "label": "Lines",
      "default": "#bcd7f0",
      "element": "Sheet"
    }
  ]
}
