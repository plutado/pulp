{
  "formatVersion": 1,
  "id": "pulp.samples.bauble",
  "name": "Bauble",
  "description": "A glass tree bauble with a band and a cap, dropping in on its hook.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "holiday-objects",
  "themes": [
    "christmas",
    "holiday"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "holiday"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "glass",
      "type": "color",
      "label": "Bauble color",
      "default": "#c1121f",
      "element": "Colors"
    },
    {
      "id": "cap",
      "type": "color",
      "label": "Cap color",
      "default": "#e9c46a",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "drop",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
