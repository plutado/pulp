{
  "formatVersion": 1,
  "id": "pulp.samples.hairline-lower-third",
  "name": "Hairline Lower Third",
  "description": "A hairline rule draws out, a name and a role settle above and below it, and the rule retracts. Quiet enough for documentary and interview footage.",
  "version": "1.0.0",
