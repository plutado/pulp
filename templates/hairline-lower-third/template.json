  "license": "CC0-1.0",
  "category": "lower-third",
  "type": "lower-third",
  "tags": ["lower third", "hairline", "minimal"],
  "themes": ["documentary", "science"],
  "styles": ["elegant", "clean"],
  "duration": 6,
  "structure": { "holdFrom": 0.83, "holdTo": 4.05 },
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
