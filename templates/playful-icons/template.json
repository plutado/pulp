{
  "formatVersion": 1,
  "id": "pulp.samples.playful-icons",
  "name": "Playful icons",
  "description": "A bright filled icon that pops in with a bounce while a burst of little dots flies out around it.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "icons",
  "themes": [
    "kids",
    "birthday",
    "social-media"
  ],
  "styles": [
    "playful"
  ],
  "tags": [
    "icon",
    "pop",
    "burst"
  ],
  "duration": 4,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "icon",
      "type": "select",
      "label": "Icon",
      "default": "heart",
      "options": [
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "thumbsup",
          "label": "Thumbs up"
        },
        {
          "value": "smiley",
          "label": "Smiley"
        },
        {
          "value": "balloon",
          "label": "Balloon"
        }
      ],
      "element": "Icon"
    },
    {
      "id": "fill",
      "type": "color",
      "label": "Icon color",
      "default": "#ff5d8f",
      "element": "Icon"
    },
    {
      "id": "detail",
      "type": "color",
      "label": "Detail color",
      "default": "#ffffff",
      "element": "Detail"
    },
    {
      "id": "dots",
      "type": "color",
      "label": "Dot color",
      "default": "#ffd166",
      "element": "Dot"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size (% of frame)",
      "default": 40,
      "min": 15,
      "max": 80,
      "step": 5,
      "element": "Layout and timing"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.7,
      "min": 0.3,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
