{
  "formatVersion": 1,
  "id": "pulp.samples.short-comment-reply",
  "name": "Comment Reply",
  "description": "The comment a video answers, on a card in the top of a tall frame: who asked, under a small \"Replying to\", and what they asked, with a round avatar. Generic, not any app's own.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "social",
  "tags": [
    "made-for-vertical",
    "short-form",
    "comment",
    "reply",
    "question"
  ],
  "themes": [
    "social-media",
    "education",
    "food"
  ],
  "styles": [
    "clean"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 1.2,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "9:16"
  ],
  "alpha": true,
  "entry": "index.html",
  "blocks": [
    {
      "id": "comment",
      "label": "Comment",
      "box": {
        "default": {
          "x": 0.1,
          "y": 0.15,
          "width": 0.7,
          "height": 0.22
        }
      },
      "gap": 0.008,
      "align": "left",
      "verticalAlign": "top",
      "typography": {
        "family": "Inter",
        "size": 0.05,
        "weight": 700,
        "color": "#111827",
        "align": "left",
        "lineHeight": 1.18,
        "maxLines": 3
      },
      "layers": [
        {
          "id": "who",
          "type": "text",
          "label": "Replying to",
          "text": "Replying to @maya.cooks",
          "size": 0.04,
          "weight": 600,
          "color": "#64748b"
        },
        {
          "id": "words",
          "type": "text",
          "label": "Comment",
          "text": "how long did this take you??",
          "required": true
        }
      ]
    }
  ],
  "parameters": [
    {
      "id": "panel",
      "type": "color",
      "label": "Card",
      "default": "#ffffff",
      "element": "Card"
    },
    {
      "id": "avatar",
      "type": "color",
      "label": "Avatar",
      "default": "#f472b6",
      "element": "Card"
    },
    {
      "id": "ink",
      "type": "color",
      "label": "Words",
      "default": "#111827",
      "element": "Card"
    }
  ]
}
