        {
          "id": "what",
          "type": "text",
          "label": "Reading",
          "text": "24° · sunny spells · light breeze",
          "size": 0.027,
          "weight": 500,
          "color": "#0369a1",
          "family": "Inter"
        }
      ]
    }
  ],
  "parameters": [
    {
