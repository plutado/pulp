{
  "formatVersion": 1,
  "id": "pulp.samples.pine-tree",
  "name": "Pine tree",
  "description": "A pine tree in three tiers on a trunk, rising into place.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "nature-objects",
  "themes": [
    "nature",
    "christmas"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "nature"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "needles",
      "type": "color",
      "label": "Tree color",
      "default": "#2e7d32",
      "element": "Colors"
    },
    {
      "id": "trunk",
      "type": "color",
      "label": "Trunk color",
      "default": "#6d4c41",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "rise",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
