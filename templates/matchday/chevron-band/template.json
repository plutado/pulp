{
  "formatVersion": 1,
  "id": "pulp.samples.matchday.chevron-band",
  "name": "Matchday chevron band",
  "description": "A band of forward chevrons marches along a chosen edge of the frame, punching in with an overshoot and snapping out.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "overlay",
  "tags": [
    "chevron",
    "band",
    "sports"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "accent",
      "type": "color",
      "label": "Chevron color",
      "default": "#d4f531",
      "element": "Chevron"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Band color",
      "default": "#101010",
      "element": "Band"
    },
    {
      "id": "edge",
      "type": "select",
      "label": "Edge",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "element": "Edge"
    },
    {
      "id": "count",
      "type": "number",
      "label": "Chevrons",
      "default": 12,
      "min": 4,
      "max": 30,
      "step": 1,
      "element": "Chevrons"
    },
    {
      "id": "speed",
      "type": "number",
      "label": "March speed",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 0.25,
      "element": "Layout and timing"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.4,
      "min": 0.15,
      "max": 1.5,
      "step": 0.05,
      "element": "Layout and timing"
    }
  ]
}
