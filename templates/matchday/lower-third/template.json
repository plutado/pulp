{
  "formatVersion": 1,
  "id": "pulp.samples.matchday.lower-third",
  "name": "Matchday lower third",
  "description": "A black bar with a volt chevron cap: player or presenter name in chunky capitals, role below.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "lower-third",
  "type": "lower-third",
  "tags": ["name", "chevron", "bold"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "name", "type": "text", "label": "Name", "default": "Riley Vance", "maxLength": 60 },
    { "id": "role", "type": "text", "label": "Role", "default": "Forward · 9", "maxLength": 60 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#d4f531", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#101010f2", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.35, "min": 0.15, "max": 1.5, "step": 0.05 }
  ]
}
