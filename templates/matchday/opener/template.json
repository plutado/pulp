{
  "formatVersion": 1,
  "id": "pulp.samples.matchday.opener",
  "name": "Matchday opener",
  "description": "A burst of chevrons, then the fixture slams in as chunky capitals on volt bars with a kick-off line below.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "opener",
  "tags": ["opener", "fixture", "chevron"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "home", "type": "text", "label": "Home team", "default": "Rovers", "maxLength": 24 },
    { "id": "away", "type": "text", "label": "Away team", "default": "United", "maxLength": 24 },
    { "id": "kickoff", "type": "text", "label": "Kick-off line", "default": "Kick-off 15:00 Saturday", "maxLength": 60 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#d4f531", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#101010", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.4, "min": 0.15, "max": 1.5, "step": 0.05 },
    { "id": "logo", "type": "image", "label": "Logo", "description": "A lockup above the fixture; with none chosen the opener is as it always was.", "box": { "x": 0.375, "y": 0.303, "width": 0.25, "height": 0.148 }, "fit": "contain", "align": "center", "margin": 0.1, "fallbackText": "kickoff", "group": "Logo" }
  ]
}
