{
  "formatVersion": 1,
  "id": "pulp.samples.matchday.follow",
  "name": "Matchday follow",
  "description": "A black handle chip with running volt chevrons that punches in, holds, and punches out.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "social",
  "tags": ["social", "handle", "chevron"],
  "duration": 5,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "handle", "type": "text", "label": "Handle", "default": "@roversfc", "maxLength": 40 },
    { "id": "label", "type": "text", "label": "Label", "default": "Follow", "maxLength": 20 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#d4f531", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#101010", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    {
      "id": "side",
      "type": "select",
      "label": "Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "right", "label": "Bottom right" }
      ]
    },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.35, "min": 0.15, "max": 1.5, "step": 0.05 }
  ]
}
