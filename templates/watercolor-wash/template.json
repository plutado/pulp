{
  "formatVersion": 1,
  "id": "pulp.samples.watercolor-wash",
  "name": "Watercolor wash",
  "description": "Overlapping watercolour blooms with darker edges where the paint pooled, on textured paper; the scale sets the bloom size and the angle their drift.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "wedding",
    "education"
  ],
  "styles": [
    "hand-drawn",
    "organic"
  ],
  "tags": [
    "still",
    "watercolor",
    "wash"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "paper",
      "type": "color",
      "label": "Paper color",
      "default": "#fbf8f1",
      "element": "Colors"
    },
    {
      "id": "c1",
      "type": "color",
      "label": "First wash",
      "default": "#7fb3d5",
      "element": "Colors"
    },
    {
      "id": "c2",
      "type": "color",
      "label": "Second wash",
      "default": "#f1948a",
      "element": "Colors"
    },
    {
      "id": "c3",
      "type": "color",
      "label": "Third wash",
      "default": "#f7dc6f",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
