      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.12,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
