{
  "formatVersion": 1,
  "id": "pulp.samples.next-workout-end-card",
  "name": "Next Workout",
  "description": "A week of effort bars that rise into place, the next session flagged at the end. Closes a training vlog or a programme check-in.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "end-card",
  "tags": [
    "end card",
    "workout",
    "chart"
  ],
  "themes": [
    "fitness",
    "sports"
  ],
  "styles": [
    "high-energy",
    "clean"
  ],
  "duration": 7,
  "structure": {
    "holdFrom": 2.0,
    "holdTo": 6.0
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "title",
      "type": "text",
      "label": "Heading",
      "default": "Next session: Thursday",
      "maxLength": 32,
      "element": "Words"
    },
    {
      "id": "line",
      "type": "text",
      "label": "Line",
      "default": "intervals · 6 × 400m · easy warm-down",
      "maxLength": 48,
      "element": "Words"
    },
    {
      "id": "back",
      "type": "color",
      "label": "Background",
      "default": "#101614",
      "element": "Scene"
    },
    {
      "id": "bar",
      "type": "color",
      "label": "Bars",
      "default": "#34d399",
      "element": "Chart"
    }
  ]
}
