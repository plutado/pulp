{
  "formatVersion": 1,
  "id": "pulp.samples.sunrise-opener",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "name": "Sunrise Opener",
  "category": "title",
  "type": "opener",
  "description": "Rays turn slowly behind a rising sun while the title lifts into place. A warm open for outdoor and daybreak stories.",
  "tags": [
    "opener",
    "sunrise",
    "rays"
  ],
  "themes": [
    "nature",
    "summer"
  ],
  "styles": [
    "organic"
  ],
  "duration": 6,
  "parameters": [
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "FIRST LIGHT",
      "maxLength": 24,
      "element": "Title"
    },
    {
      "id": "sky",
      "type": "color",
      "label": "Sky",
      "default": "#2a1a3a",
      "element": "Scene"
    },
    {
      "id": "sun",
      "type": "color",
      "label": "Sun",
      "default": "#ffb65c",
      "element": "Scene"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Hold, seconds",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
