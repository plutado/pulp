    "motorsport"
  ],
  "styles": [
    "tech",
    "clean"
  ],
  "tags": [
    "still",
    "metal",
    "brushed"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
