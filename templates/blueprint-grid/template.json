{
  "formatVersion": 1,
  "id": "pulp.samples.blueprint-grid",
  "name": "Blueprint grid",
  "description": "Drafting blue with a fine grid and heavier major lines, a few construction circles and arcs; the scale sets the grid pitch and the angle turns it.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "technology",
    "education",
    "real-estate"
  ],
  "styles": [
    "tech",
    "clean"
  ],
  "tags": [
    "still",
    "blueprint",
    "grid"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "base",
      "type": "color",
      "label": "Paper color",
      "default": "#0d3b8c",
      "element": "Colors"
    },
    {
      "id": "line",
      "type": "color",
      "label": "Line color",
      "default": "#cfe3ff",
      "element": "Colors"
    },
    {
      "id": "mark",
      "type": "color",
      "label": "Construction color",
      "default": "#7fb2ff",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
