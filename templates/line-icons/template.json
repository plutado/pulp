{
  "formatVersion": 1,
  "id": "pulp.samples.line-icons",
  "name": "Line icons",
  "description": "One clean stroked icon that draws itself in over a thin circular backing ring, then unwinds to leave.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "icons",
  "themes": [
    "corporate",
    "technology",
    "education",
    "civic"
  ],
  "styles": [
    "clean"
  ],
  "tags": [
    "icon",
    "line",
    "stroke"
  ],
  "duration": 5,
  "structure": { "holdFrom": 2.23, "holdTo": 2.85 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "icon",
      "type": "select",
      "label": "Icon",
      "default": "check",
      "options": [
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "play",
          "label": "Play"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "bell",
          "label": "Bell"
        },
        {
          "value": "gear",
          "label": "Gear"
        }
      ],
      "element": "Icon"
    },
    {
      "id": "stroke",
      "type": "color",
      "label": "Stroke color",
      "default": "#1e293b",
      "element": "Stroke"
    },
    {
      "id": "ring",
      "type": "color",
      "label": "Ring color",
      "default": "#38bdf8",
      "element": "Ring"
    },
    {
      "id": "weight",
      "type": "number",
      "label": "Stroke weight",
      "default": 10,
      "min": 3,
      "max": 24,
      "step": 1,
      "element": "Stroke"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size (% of frame)",
      "default": 40,
      "min": 15,
      "max": 80,
      "step": 5,
      "element": "Layout and timing"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
