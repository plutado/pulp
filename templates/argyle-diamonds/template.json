{
  "formatVersion": 1,
  "id": "pulp.samples.argyle-diamonds",
  "name": "Argyle diamonds",
  "description": "The knitted argyle: diamonds in two colours over a base, with thin crossing lines; the scale sets the diamond size and the angle turns the knit.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "fashion",
    "golf"
  ],
  "styles": [
    "retro",
    "elegant"
  ],
  "tags": [
    "still",
    "argyle",
    "pattern"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "base",
      "type": "color",
      "label": "Base color",
      "default": "#1f2a44",
      "element": "Colors"
    },
    {
      "id": "d1",
      "type": "color",
      "label": "First diamond",
      "default": "#8b1e3f",
      "element": "Colors"
    },
    {
      "id": "d2",
      "type": "color",
      "label": "Second diamond",
      "default": "#d9b36c",
      "element": "Colors"
    },
    {
      "id": "line",
      "type": "color",
      "label": "Overcheck color",
      "default": "#f5f0e6",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
