{
  "formatVersion": 1,
  "id": "pulp.samples.birthday-cake",
  "name": "Birthday cake",
  "description": "A two-tier cake with candles and frosting drips, rising into place.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "celebration-objects",
  "themes": [
    "birthday",
    "kids"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "celebration"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "cake",
      "type": "color",
      "label": "Cake color",
      "default": "#f4a261",
      "element": "Colors"
    },
    {
      "id": "icing",
      "type": "color",
      "label": "Icing color",
      "default": "#fff1e6",
      "element": "Colors"
    },
    {
      "id": "flame",
      "type": "color",
      "label": "Candle color",
      "default": "#ffb703",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "rise",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
