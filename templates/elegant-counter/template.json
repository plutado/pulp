{
  "formatVersion": 1,
  "id": "pulp.samples.elegant-counter",
  "name": "Elegant counter",
  "description": "Serif figures counting up over a thin gold rule with a spaced small-caps label, ivory and gold on transparent.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "counter",
  "themes": [
    "wedding",
    "fashion",
    "memorial"
  ],
  "styles": [
    "elegant"
  ],
  "tags": [
    "number",
    "serif",
    "count up"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "start",
      "type": "number",
      "label": "Start value",
      "default": 0,
      "min": -1000000000,
      "max": 1000000000,
      "step": 0.01,
      "element": "Figures"
    },
    {
      "id": "target",
      "type": "number",
      "label": "Target value",
      "default": 1964,
      "min": -1000000000,
      "max": 1000000000,
      "step": 0.01,
      "element": "Figures"
    },
    {
      "id": "decimals",
      "type": "number",
      "label": "Decimals",
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 1,
      "element": "Figures"
    },
    {
      "id": "separators",
      "type": "boolean",
      "label": "Thousands separators",
      "default": false,
      "element": "Figures"
    },
    {
      "id": "prefix",
      "type": "text",
      "label": "Prefix",
      "default": "",
      "maxLength": 6,
      "element": "Figures"
    },
    {
      "id": "suffix",
      "type": "text",
      "label": "Suffix",
      "default": "",
      "maxLength": 6,
      "element": "Figures"
    },
    {
      "id": "label",
      "type": "text",
      "label": "Label",
      "default": "Est. in the year",
      "maxLength": 48,
      "element": "Label"
    },
    {
      "id": "ivory",
      "type": "color",
      "label": "Figure color",
      "default": "#f6efe3",
      "element": "Figure"
    },
    {
      "id": "gold",
      "type": "color",
      "label": "Rule and label color",
      "default": "#c9a24e",
      "element": "Rule"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 1,
      "min": 0.2,
      "max": 2.5,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
