{
  "formatVersion": 1,
  "id": "pulp.samples.soft-vignette",
  "name": "Soft vignette",
  "description": "A soft, warm-tinted radial vignette with adjustable size and softness that fades in and holds.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "vignette",
  "themes": [
    "nature",
    "wedding",
    "family"
  ],
  "styles": [
    "organic"
  ],
  "tags": [
    "vignette",
    "soft",
    "warm"
  ],
  "duration": 8,
  "structure": { "holdFrom": 2.15, "holdTo": 5.85 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "color",
      "type": "color",
      "label": "Edge color",
      "default": "#3a2416",
      "element": "Edge"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size",
      "default": 0.7,
      "min": 0.3,
      "max": 1.2,
      "step": 0.05,
      "description": "How far from the centre the darkening begins.",
      "element": "Soft vignette"
    },
    {
      "id": "softness",
      "type": "number",
      "label": "Softness",
      "default": 0.6,
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "element": "Soft vignette"
    },
    {
      "id": "strength",
      "type": "number",
      "label": "Strength",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Soft vignette"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Fade in/out (seconds)",
      "default": 1.2,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
