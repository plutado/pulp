      "step": 1,
      "element": "Line"
    },
    {
      "id": "bandSpeed",
      "type": "number",
      "label": "Band passes per loop",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 1,
      "element": "Band passes per loop"
    },
    {
      "id": "grid",
      "type": "boolean",
      "label": "Faint grid",
      "default": true,
      "element": "Faint grid"
    }
  ]
