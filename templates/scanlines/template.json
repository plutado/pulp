{
  "formatVersion": 1,
  "id": "pulp.samples.scanlines",
  "name": "Scanlines",
  "description": "A dark field with horizontal scanlines, a slow rolling band and a faint grid; loops seamlessly.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "texture",
  "themes": [
    "technology",
    "gaming",
    "science"
  ],
  "styles": [
    "tech"
  ],
  "tags": [
    "scanlines",
    "crt",
    "grid"
  ],
  "duration": 8,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
