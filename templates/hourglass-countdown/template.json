{
  "formatVersion": 1,
  "id": "pulp.samples.hourglass-countdown",
  "name": "Hourglass",
  "description": "An hourglass whose sand drains from the top bulb to the bottom as the count falls. Counts in a story beat or a timed segment, slowly.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "countdown",
  "tags": [
    "countdown",
    "hourglass",
    "sand"
  ],
  "themes": [
    "documentary",
    "education",
    "kids"
  ],
  "styles": [
    "organic",
    "elegant"
  ],
  "duration": 8,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "from",
      "type": "number",
      "label": "Count from",
      "default": 10,
      "min": 1,
      "max": 99,
      "element": "Glass"
    },
    {
      "id": "sand",
      "type": "color",
      "label": "Sand",
      "default": "#e9c46a",
      "element": "Glass"
    },
    {
      "id": "glass",
      "type": "color",
      "label": "Glass",
      "default": "#f1f5f9",
      "element": "Glass"
    }
  ]
}
