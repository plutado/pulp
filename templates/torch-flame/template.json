{
  "formatVersion": 1,
  "id": "pulp.samples.torch-flame",
  "name": "Torch flame",
  "description": "One tall torch flame with a teardrop body and a hot core, swaying as it burns; loops.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "fire",
  "themes": [
    "holiday",
    "cinema"
  ],
  "styles": [
    "cinematic"
  ],
  "tags": [
    "effect",
    "fire",
    "torch"
  ],
  "duration": 4,
  "fps": 30,
  "structure": {
    "loop": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "color",
