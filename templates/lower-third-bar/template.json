{
  "formatVersion": 1,
  "id": "pulp.samples.lower-third-bar",
  "name": "Lower Third Bar",
  "description": "Name and title on a panel with an accent bar that slides in, holds, and slides out. The words are layers: add a line and the panel grows to hold it, and it rides the same wipe and fade.",
  "version": "1.1.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "lower-third",
  "tags": [
    "lower-third",
    "name",
    "interview",
    "clean"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "accent",
      "type": "color",
      "label": "Accent bar",
      "default": "#f59e0b",
      "element": "Panel"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Fill",
      "default": "#111827d9",
      "element": "Panel"
    },
    {
      "id": "side",
      "type": "select",
      "label": "Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Bottom left"
        },
        {
          "value": "right",
          "label": "Bottom right"
        }
      ]
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.6,
      "min": 0.1,
      "max": 2,
      "step": 0.1
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A logo badge at the head of the panel; with none chosen the panel is as it always was.",
      "box": {
        "x": 0.05,
        "y": 0.79,
        "width": 0.07,
        "height": 0.125
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.12,
      "fallbackText": "name",
      "element": "Logo"
    }
  ],
  "blocks": [
    {
      "id": "strap",
      "label": "Strap",
      "box": {
        "x": 0.05,
        "y": 0.75,
        "width": 0.9,
        "height": 0.15
      },
      "direction": "column",
      "gap": 0.0103703704,
      "align": "left",
      "verticalAlign": "top",
      "open": true,
      "typography": {
        "family": "Helvetica Neue, Arial, sans-serif",
        "size": 0.05,
        "weight": 600,
        "color": "#ffffff",
        "overflow": "shrink"
      },
      "layers": [
        {
          "id": "name",
          "type": "text",
          "label": "Name",
          "text": "Alex Rivera",
          "required": true
        },
        {
          "id": "title",
          "type": "text",
          "label": "Title",
          "text": "Director of Photography",
          "size": 0.0277777778,
          "weight": 400
        }
      ]
    }
  ]
}
