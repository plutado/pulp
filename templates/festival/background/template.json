{
  "formatVersion": 1,
  "id": "pulp.samples.festival.background",
  "name": "Festival background",
  "description": "A deep plum glow with warm bokeh drifting upward; loops seamlessly for any celebration.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "animated-loop",
  "tags": ["loop", "bokeh", "warm"],
  "duration": 8,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    { "id": "base", "type": "color", "label": "Base color", "default": "#341f3e", "group": "Colors" },
    { "id": "deep", "type": "color", "label": "Deep color", "default": "#1b0f22", "group": "Colors" },
    { "id": "gold", "type": "color", "label": "Bokeh color", "default": "#e8b54d", "group": "Colors" },
    { "id": "amount", "type": "number", "label": "Bokeh amount", "default": 22, "min": 6, "max": 48, "step": 1 },
    { "id": "glow", "type": "number", "label": "Glow strength", "default": 0.35, "min": 0, "max": 1, "step": 0.05 },
    { "id": "logo", "type": "image", "label": "Logo", "description": "A watermark in the bottom-right corner at 18% opacity; nothing is drawn without one.", "box": { "x": 0.894, "y": 0.811, "width": 0.073, "height": 0.13 }, "fit": "contain", "align": "center", "margin": 0.1, "group": "Logo" }
  ]
}
