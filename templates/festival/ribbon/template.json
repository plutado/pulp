{
  "formatVersion": 1,
  "id": "pulp.samples.festival.ribbon",
  "name": "Festival ribbon",
  "description": "A gold ribbon waves gently along the bottom or top of the frame with small twinkles drifting above it, fading in and out.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "overlay",
  "tags": [
    "ribbon",
    "wave",
    "festive"
  ],
  "duration": 8,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "gold",
      "type": "color",
      "label": "Ribbon color",
      "default": "#e8b54d",
      "element": "Ribbon"
    },
    {
      "id": "second",
      "type": "color",
      "label": "Highlight color",
      "default": "#fff1c9",
      "element": "Highlight"
    },
    {
      "id": "edge",
      "type": "select",
      "label": "Edge",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        }
      ],
      "element": "Edge"
    },
    {
      "id": "wave",
      "type": "number",
      "label": "Wave amount",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Wave"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.8,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ],
  "themes": [
    "wedding"
  ]
}
