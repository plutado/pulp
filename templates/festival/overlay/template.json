{
  "formatVersion": 1,
  "id": "pulp.samples.festival.overlay",
  "name": "Festival sparkle corners",
  "description": "Soft gold bokeh and twinkling sparkles arcing out of two corners, holding through the shot.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "light-particles",
  "tags": ["bokeh", "sparkle", "corners"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "gold", "type": "color", "label": "Glow color", "default": "#e8b54d", "group": "Colors" },
    { "id": "second", "type": "color", "label": "Second color", "default": "#fff6e8", "group": "Colors" },
    { "id": "amount", "type": "number", "label": "Amount", "default": 18, "min": 6, "max": 40, "step": 1 },
    {
      "id": "corners",
      "type": "select",
      "label": "Corners",
      "default": "bottom",
      "options": [
        { "value": "bottom", "label": "Bottom corners" },
        { "value": "top", "label": "Top corners" },
        { "value": "all", "label": "All corners" }
      ]
    },
    { "id": "inOut", "type": "number", "label": "Fade in/out (seconds)", "default": 0.8, "min": 0.2, "max": 2, "step": 0.1 },
    { "id": "logo", "type": "image", "label": "Logo", "description": "A small logo in the chosen corner among the twinkles; nothing is drawn without one.", "box": { "x": 0.908, "y": 0.837, "width": 0.0625, "height": 0.111 }, "fit": "contain", "align": "center", "margin": 0.1 }
  ]
}
