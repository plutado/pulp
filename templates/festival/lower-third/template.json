{
  "formatVersion": 1,
  "id": "pulp.samples.festival.lower-third",
  "name": "Festival lower third",
  "description": "A rounded plum pill with a gold rim, name in warm serif, and a few confetti dots drifting up.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "lower-third",
  "type": "lower-third",
  "tags": [
    "name",
    "festive",
    "warm"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "default": "Sam Arceneaux",
      "maxLength": 60,
      "element": "Name"
    },
    {
      "id": "subtitle",
      "type": "text",
      "label": "Subtitle",
      "default": "Host of the evening",
      "maxLength": 80,
      "element": "Subtitle"
    },
    {
      "id": "gold",
      "type": "color",
      "label": "Gold color",
      "default": "#e8b54d",
      "element": "Gold"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Panel color",
      "default": "#341f3ee6",
      "element": "Panel"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#fff6e8",
      "element": "Text"
    },
    {
      "id": "confetti",
      "type": "boolean",
      "label": "Confetti",
      "default": true,
      "element": "Confetti"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.6,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A round badge at the head of the pill, before the name; with none chosen the pill is as it always was.",
      "box": {
        "x": 0.065,
        "y": 0.774,
        "width": 0.0625,
        "height": 0.111
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name",
      "element": "Logo"
    }
  ]
}
