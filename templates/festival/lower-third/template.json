    { "id": "logo", "type": "image", "label": "Logo", "description": "A round badge at the head of the pill, before the name; with none chosen the pill is as it always was.", "box": { "x": 0.065, "y": 0.774, "width": 0.0625, "height": 0.111 }, "fit": "contain", "align": "center", "margin": 0.1, "fallbackText": "name", "group": "Logo" }
  ]
