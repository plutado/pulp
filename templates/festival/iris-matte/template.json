{
  "formatVersion": 1,
  "id": "pulp.samples.festival.iris-matte",
  "name": "Festival iris matte",
  "description": "A plum field with a soft-edged, gold-rimmed circular hole that closes to nothing at the midpoint and opens again, twinkling at the rim.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "transition",
  "type": "reveal",
  "tags": [
    "reveal",
    "iris",
    "festive"
  ],
  "duration": 1.4,
  "structure": { "scale": true },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "panel",
      "type": "color",
      "label": "Field color",
      "default": "#341f3e",
      "element": "Field"
    },
    {
      "id": "gold",
      "type": "color",
      "label": "Rim color",
      "default": "#e8b54d",
      "element": "Rim"
    },
    {
      "id": "softness",
      "type": "number",
      "label": "Edge softness",
      "default": 0.12,
      "min": 0,
      "max": 0.4,
      "step": 0.02,
      "element": "Edge"
    },
    {
      "id": "twinkles",
      "type": "number",
      "label": "Twinkles",
      "default": 7,
      "min": 0,
      "max": 16,
      "step": 1,
      "element": "Twinkles"
    },
    {
      "id": "position",
      "type": "select",
      "label": "Iris position",
      "default": "centre",
      "options": [
        {
          "value": "centre",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "element": "Layout and timing"
    }
  ],
  "themes": [
    "holiday"
  ]
}
