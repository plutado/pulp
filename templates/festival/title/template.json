{
  "formatVersion": 1,
  "id": "pulp.samples.festival.title",
  "name": "Festival title",
  "description": "A warm serif headline between two gold arcs, with soft bokeh rising behind.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "title",
  "tags": [
    "headline",
    "festive",
    "warm"
  ],
  "duration": 5,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "kicker",
      "type": "text",
      "label": "Kicker",
      "default": "You are invited",
      "maxLength": 40,
      "element": "Kicker"
    },
    {
      "id": "headline",
      "type": "text",
      "label": "Headline",
      "default": "A night to celebrate",
      "maxLength": 50,
      "element": "Headline"
    },
    {
      "id": "gold",
      "type": "color",
      "label": "Gold color",
      "default": "#e8b54d",
      "element": "Gold"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#fff6e8",
      "element": "Text"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.8,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A mark above the kicker; with none chosen the kicker stands alone as before.",
      "box": {
        "x": 0.471,
        "y": 0.309,
        "width": 0.057,
        "height": 0.102
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "kicker",
      "element": "Logo"
    }
  ],
  "themes": [
    "holiday"
  ]
}
