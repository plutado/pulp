{
  "formatVersion": 1,
  "id": "pulp.samples.festival.confetti-burst",
  "name": "Festival confetti burst",
  "description": "A burst of confetti from a chosen point that flies out, tumbles and falls under gravity, fading away near the end.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "light-particles",
  "tags": [
    "confetti",
    "burst",
    "celebration"
  ],
  "duration": 6,
  "structure": { "loop": true },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "gold",
      "type": "color",
      "label": "Gold",
      "default": "#e8b54d",
      "element": "Gold"
    },
    {
      "id": "first",
      "type": "color",
      "label": "Second color",
      "default": "#f06f9b",
      "element": "Second"
    },
    {
      "id": "second",
      "type": "color",
      "label": "Third color",
      "default": "#7ad7d0",
      "element": "Third"
    },
    {
      "id": "amount",
      "type": "number",
      "label": "Amount",
      "default": 140,
      "min": 30,
      "max": 400,
      "step": 10,
      "element": "Festival confetti burst"
    },
    {
      "id": "origin",
      "type": "select",
      "label": "Origin",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom centre"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "top",
          "label": "Top centre"
        }
      ],
      "element": "Origin"
    },
    {
      "id": "spread",
      "type": "number",
      "label": "Spread (degrees)",
      "default": 70,
      "min": 20,
      "max": 180,
      "step": 5,
      "element": "Spread"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Fade out (seconds)",
      "default": 1.2,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ],
  "themes": [
    "birthday"
  ]
}
