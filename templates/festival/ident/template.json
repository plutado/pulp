{
  "formatVersion": 1,
  "id": "pulp.samples.festival.ident",
  "name": "Festival ident",
  "description": "A gold twinkle blooms at the centre, the logo blooms up through it with a little bounce, a few twinkles settle around it, then it fades.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "logo-reveal",
  "tags": [
    "ident",
    "logo",
    "twinkle"
  ],
  "duration": 3,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "default": "Festival Nights",
      "maxLength": 50,
      "description": "Set in warm serif type where the logo would be when no logo is chosen.",
      "element": "Name"
    },
    {
      "id": "ground",
      "type": "color",
      "label": "Ground color",
      "default": "#341f3e",
      "element": "Ground"
    },
    {
      "id": "gold",
      "type": "color",
      "label": "Gold color",
      "default": "#e8b54d",
      "element": "Gold"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#fff6e8",
      "element": "Text"
    },
    {
      "id": "twinkles",
      "type": "number",
      "label": "Twinkles",
      "default": 24,
      "min": 0,
      "max": 60,
      "step": 1,
      "element": "Twinkles"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "Blooms up at the centre; with none chosen the name stands in as a wordmark.",
      "box": {
        "x": 0.37,
        "y": 0.35,
        "width": 0.26,
        "height": 0.3
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name",
      "element": "Logo"
    }
  ]
}
