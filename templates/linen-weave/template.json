{
  "formatVersion": 1,
  "id": "pulp.samples.linen-weave",
  "name": "Linen weave",
  "description": "A linen cloth: fine crossing threads with slight irregularity over a flat color, turned by the angle; the scale sets the thread count.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "texture",
  "themes": [
    "fashion",
    "wedding"
  ],
  "styles": [
    "elegant",
    "organic"
  ],
  "tags": [
    "still",
    "fabric",
    "linen"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "base",
      "type": "color",
      "label": "Cloth color",
      "default": "#d9d2c3",
      "element": "Colors"
    },
    {
      "id": "thread",
      "type": "color",
      "label": "Thread color",
      "default": "#8f846f",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
