{
  "formatVersion": 1,
  "id": "pulp.samples.plate-title",
  "name": "Plate Title",
  "description": "A title over a moving plate: a library clip plays full-frame behind the words, darkened at the foot so the type reads, the title rising in over it. With no clip chosen the plate is a flat color, so the card works as a plain title too.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "title",
  "themes": ["documentary", "travel", "corporate"],
  "styles": ["cinematic", "clean"],
  "tags": ["title", "plate", "footage", "opener"],
  "duration": 6,
  "structure": { "holdFrom": 1.4, "holdTo": 5.2 },
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": false,
  "entry": "index.html",
  "posterAt": 3,
  "parameters": [
    {
      "id": "plate",
      "type": "media",
      "label": "Plate",
      "element": "Plate",
      "description": "The clip that plays behind the title, filling the frame. Trim it to the stretch you want; it loops by default.",
      "box": { "x": 0, "y": 0, "width": 1, "height": 1 },
      "fit": "cover",
      "align": "center"
    },
    { "id": "plateColor", "type": "color", "label": "Color without a clip", "default": "#1f2937", "element": "Plate" },
    { "id": "shade", "type": "number", "label": "Shade at the foot", "default": 0.7, "min": 0, "max": 1, "step": 0.05, "element": "Plate" },
    { "id": "title", "type": "text", "label": "Title", "default": "North Coast", "maxLength": 40, "element": "Title" },
    { "id": "subtitle", "type": "text", "label": "Subtitle", "default": "Episode one", "maxLength": 60, "element": "Title" },
    { "id": "ink", "type": "color", "label": "Ink", "default": "#f8fafc", "element": "Title" },
    { "id": "accent", "type": "color", "label": "Accent", "default": "#f59e0b", "element": "Title" }
  ]
}
