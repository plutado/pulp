{
  "formatVersion": 1,
  "id": "pulp.samples.letterbox-vignette",
  "name": "Letterbox vignette",
  "description": "Black letterbox bars for a chosen picture ratio that slide in from the edges, with a gentle vignette inside them; tall frames get pillar bars instead.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "vignette",
  "themes": [
    "cinema",
    "documentary"
  ],
  "styles": [
    "cinematic"
  ],
  "tags": [
    "letterbox",
    "bars",
    "vignette"
  ],
  "duration": 8,
  "structure": { "holdFrom": 2.11, "holdTo": 5.89 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "ratio",
      "type": "select",
      "label": "Picture ratio",
      "default": "2.39",
      "options": [
        {
          "value": "2.39",
          "label": "2.39 : 1"
        },
        {
          "value": "2.0",
          "label": "2.00 : 1"
        },
        {
          "value": "1.85",
          "label": "1.85 : 1"
        }
      ],
      "element": "Picture ratio"
    },
    {
      "id": "bar",
      "type": "color",
      "label": "Bar color",
      "default": "#000000",
      "element": "Bar"
    },
    {
      "id": "vignette",
      "type": "number",
      "label": "Vignette strength",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Vignette"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
