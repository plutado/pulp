{
  "formatVersion": 1,
  "id": "pulp.samples.listen-next-end-card",
  "name": "Listen Next",
  "description": "A podcast close: waveform bars breathe under the show name, with \"listen next\" and the episode line. The bars keep moving, so the card has a fixed length.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "end-card",
  "tags": [
    "end card",
    "podcast",
    "waveform"
  ],
  "themes": [
    "podcast",
    "concert"
  ],
  "styles": [
    "clean"
  ],
  "duration": 7,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "show",
      "type": "text",
      "label": "Show",
      "default": "Big Questions",
      "maxLength": 30,
      "element": "Words"
    },
    {
      "id": "next",
      "type": "text",
      "label": "Next line",
      "default": "Next week: the long now",
      "maxLength": 48,
      "element": "Words"
    },
    {
      "id": "back",
      "type": "color",
      "label": "Background",
      "default": "#111827",
      "element": "Scene"
    },
    {
      "id": "bars",
      "type": "color",
      "label": "Bars",
      "default": "#a78bfa",
      "element": "Scene"
    }
  ]
}
