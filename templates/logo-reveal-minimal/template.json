{
  "formatVersion": 1,
  "id": "pulp.samples.logo-reveal-minimal",
  "name": "Minimal logo reveal",
  "description": "On a quiet ground the logo fades up from ninety percent, a hairline draws beneath it and a one-line tagline settles under the line; with no logo chosen the name is set in type instead.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "logo-reveal",
  "themes": [
    "corporate",
    "technology"
  ],
  "styles": [
    "clean"
  ],
  "tags": [
    "logo",
    "reveal",
    "minimal"
  ],
  "duration": 5,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "default": "Northwind",
      "maxLength": 40,
      "description": "Set in type where the logo would be when no logo is chosen.",
      "element": "Name"
    },
    {
      "id": "tagline",
      "type": "text",
      "label": "Tagline",
      "default": "Built for the long run",
      "maxLength": 80,
      "element": "Tagline"
    },
    {
      "id": "ground",
      "type": "color",
      "label": "Ground",
      "default": "#0b1020ff",
      "description": "Alpha 00 for a transparent ground.",
      "element": "Ground"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Hairline color",
      "default": "#5aa9ff",
      "element": "Hairline"
    },
    {
      "id": "ink",
      "type": "color",
      "label": "Text color",
      "default": "#f4f6fb",
      "element": "Text"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Fade in/out (seconds)",
      "default": 0.9,
      "min": 0.3,
      "max": 1.6,
      "step": 0.1,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "Rests in the middle of the frame and rides the fade and scale; falls back to the name.",
      "box": {
        "16:9": {
          "x": 0.36,
          "y": 0.32,
          "width": 0.28,
          "height": 0.3
        },
        "9:16": {
          "x": 0.2,
          "y": 0.38,
          "width": 0.6,
          "height": 0.17
        },
        "1:1": {
          "x": 0.25,
          "y": 0.33,
          "width": 0.5,
          "height": 0.28
        },
        "4:5": {
          "x": 0.25,
          "y": 0.35,
          "width": 0.5,
          "height": 0.23
        }
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name",
      "element": "Logo"
    }
  ]
}
