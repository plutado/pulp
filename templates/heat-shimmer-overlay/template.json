{
  "formatVersion": 1,
  "id": "pulp.samples.heat-shimmer-overlay",
  "name": "Heat Shimmer",
  "description": "Rising bands of shimmer, as off hot tarmac, warping softly over the lower picture. Says summer or desert in one layer.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "overlay",
  "tags": [
    "overlay",
    "heat",
    "shimmer"
  ],
  "themes": [
    "summer",
    "travel",
    "motorsport"
  ],
  "styles": [
    "cinematic",
    "organic"
  ],
  "duration": 4,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "amount",
      "type": "number",
      "label": "Amount",
      "default": 0.6,
      "min": 0.2,
      "max": 1,
      "element": "Shimmer"
    }
  ]
}
