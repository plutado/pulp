{
  "formatVersion": 1,
  "id": "pulp.samples.dotted-path-arrow",
  "name": "Dotted Path",
  "description": "Dots that light up along a dashed path toward the arrowhead, over and over, like a route being traced. Leads the eye along a map or a diagram.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "arrows",
  "tags": [
    "arrows",
    "path",
    "dots"
  ],
  "themes": [
    "travel",
    "education",
    "technology"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "dot",
      "type": "color",
      "label": "Dots",
      "default": "#38bdf8",
      "element": "Path"
    },
    {
      "id": "bend",
      "type": "number",
      "label": "Bend",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "element": "Path"
    }
  ]
}
