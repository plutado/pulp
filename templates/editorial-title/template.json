    },
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "The Quiet Years",
      "maxLength": 34,
      "element": "Words"
    },
    {
      "id": "ink",
      "type": "color",
      "label": "Ink",
      "default": "#f5f2ea",
      "element": "Words"
    },
    {
      "id": "rule",
      "type": "color",
      "label": "Rule",
      "default": "#b4934a",
      "element": "Rule"
    }
  ]
}
