{
  "formatVersion": 1,
  "id": "pulp.samples.mosaic-wipe",
  "name": "Mosaic Wipe",
  "description": "A grid of tiles that flips on in a diagonal wave and off again behind it. Cuts montages that want texture without a hard line.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "transition",
  "type": "wipe",
  "tags": [
    "transition",
    "wipe",
    "mosaic"
  ],
  "themes": [
    "technology",
    "gaming",
    "media"
  ],
  "styles": [
    "tech",
    "playful"
  ],
  "duration": 1.5,
  "structure": {
    "scale": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "tile",
      "type": "color",
      "label": "Tiles",
      "default": "#0e7490",
      "element": "Tiles"
    },
    {
      "id": "cells",
      "type": "number",
      "label": "Tiles across",
      "default": 16,
      "min": 8,
      "max": 28,
      "element": "Tiles"
    }
  ]
}
