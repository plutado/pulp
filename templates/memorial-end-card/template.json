  "alpha": true,
  "entry": "index.html",
  "name": "Memorial End Card",
  "category": "title",
  "type": "end-card",
  "description": "A candle glow breathes behind a name and two dates, over a slow vignette. A quiet close for remembrance pieces.",
  "tags": [
    "end card",
    "memorial",
    "candle"
  ],
  "themes": [
    "memorial",
    "faith"
  ],
  "styles": [
    "elegant"
  ],
  "duration": 7,
  "blocks": [
    {
      "id": "words",
      "label": "Words",
