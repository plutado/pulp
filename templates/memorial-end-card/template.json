          "weight": 400,
          "letterSpacing": 0.18,
          "color": "#cbbfa4",
          "family": "Inter"
        },
        {
          "id": "line",
          "type": "text",
          "label": "Line",
          "text": "Loved, and remembered",
          "size": 0.028,
          "weight": 400,
          "italic": true,
          "color": "#a99c80"
        }
      ]
    }
