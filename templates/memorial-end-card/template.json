          "x": 0.2,
          "y": 0.34,
          "width": 0.6,
          "height": 0.36
        },
        "default": {
          "x": 0.1,
          "y": 0.34,
          "width": 0.8,
          "height": 0.4
        }
      },
      "gap": 0.018,
      "align": "center",
      "verticalAlign": "middle",
      "typography": {
        "family": "Playfair",
        "size": 0.085,
