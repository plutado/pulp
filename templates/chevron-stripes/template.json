{
  "formatVersion": 1,
  "id": "pulp.samples.chevron-stripes",
  "name": "Chevron stripes",
  "description": "Bold zigzag chevrons in two colours with an accent every fourth row; the scale sets the chevron height and the angle turns the field.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "still-background",
  "themes": [
    "sports",
    "fitness"
  ],
  "styles": [
    "high-energy",
    "playful"
  ],
  "tags": [
    "still",
    "chevron",
    "geometric"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "c1",
      "type": "color",
      "label": "First stripe",
      "default": "#111827",
      "element": "Colors"
    },
    {
      "id": "c2",
      "type": "color",
      "label": "Second stripe",
      "default": "#1f2937",
      "element": "Colors"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent stripe",
      "default": "#f97316",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.05,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
