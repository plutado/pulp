{
  "formatVersion": 1,
  "id": "pulp.samples.fire-line",
  "name": "Line of fire",
  "description": "A low band of fire burning along the bottom of the frame, for a strap or a lower edge; loops.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "fire",
  "themes": [
    "gaming",
    "sports"
  ],
  "styles": [
    "high-energy",
    "grunge"
  ],
  "tags": [
    "effect",
    "fire",
    "border"
  ],
  "duration": 4,
  "fps": 30,
  "structure": {
    "loop": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "color",
      "type": "color",
      "label": "Color",
      "default": "#ff8a3d",
      "element": "Color"
    },
    {
      "id": "speed",
      "type": "number",
      "label": "Speed",
      "default": 1,
      "min": 0.25,
      "max": 3,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "density",
      "type": "number",
      "label": "Density",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.05,
      "element": "Motion"
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.05,
      "element": "Motion"
    }
  ]
}
