{
  "formatVersion": 1,
  "id": "pulp.samples.citation-callout",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "name": "Citation Callout",
  "category": "title",
  "type": "callout",
  "description": "A ruled citation card that underlines its source as it settles. For quoting a statute, a filing or a published line on screen.",
  "tags": [
    "callout",
    "citation",
    "legal"
  ],
  "themes": [
    "legal",
    "civic"
  ],
  "styles": [
    "corporate"
  ],
  "duration": 6,
  "structure": { "holdFrom": 1.35, "holdTo": 3.97 },
  "parameters": [
    {
      "id": "quote",
      "type": "text",
      "label": "Line",
      "default": "No person shall be deprived of equal protection.",
      "maxLength": 90,
      "element": "Card"
    },
    {
      "id": "source",
      "type": "text",
      "label": "Source",
      "default": "Art. 14, Sec. 1",
      "maxLength": 32,
      "element": "Card"
    },
    {
      "id": "rule",
      "type": "color",
      "label": "Rule",
      "default": "#b08d2f",
      "element": "Card"
    },
    {
      "id": "x",
      "type": "number",
      "label": "Across, %",
      "default": 50,
      "min": 20,
      "max": 80,
      "step": 1,
      "element": "Layout and timing"
    },
    {
      "id": "y",
      "type": "number",
      "label": "Down, %",
      "default": 70,
      "min": 15,
      "max": 85,
      "step": 1,
      "element": "Layout and timing"
    }
  ]
}
