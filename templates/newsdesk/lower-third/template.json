{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.lower-third",
  "name": "Newsdesk lower third",
  "description": "A dark bar with a red slash cap: name in bold capitals, topic below, and an optional pulsing live flag.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "lower-third",
  "type": "lower-third",
  "tags": ["name", "broadcast", "slash"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "name", "type": "text", "label": "Name", "default": "Dana Okafor", "maxLength": 60 },
    { "id": "topic", "type": "text", "label": "Topic", "default": "City hall briefing", "maxLength": 80 },
    { "id": "live", "type": "boolean", "label": "Live flag", "default": true },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#e0263c", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#0e1526f2", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.4, "min": 0.15, "max": 1.5, "step": 0.05 },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A badge in the slashed panel's head, before the name; the panel grows to hold it. With none chosen the bar is as it always was.",
      "box": { "x": 0.095, "y": 0.817, "width": 0.045, "height": 0.08 },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name"
    }
  ]
}
