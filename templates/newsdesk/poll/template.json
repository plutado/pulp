{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.poll",
  "name": "Newsdesk poll",
  "description": "A poll question over two to four options whose slash-cut bars fill to their percentages, red on navy.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "infographic",
  "tags": ["poll", "survey", "bars"],
  "duration": 7,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "question", "type": "text", "label": "Question", "default": "Should the council approve the plan?", "maxLength": 80 },
    { "id": "option1", "type": "text", "label": "Option 1", "default": "Yes", "maxLength": 32, "group": "Options" },
    { "id": "pct1", "type": "number", "label": "Option 1 (%)", "default": 48, "min": 0, "max": 100, "step": 1, "group": "Options" },
    { "id": "option2", "type": "text", "label": "Option 2", "default": "No", "maxLength": 32, "group": "Options" },
    { "id": "pct2", "type": "number", "label": "Option 2 (%)", "default": 37, "min": 0, "max": 100, "step": 1, "group": "Options" },
    { "id": "option3", "type": "text", "label": "Option 3 (blank to hide)", "default": "Undecided", "maxLength": 32, "group": "Options" },
    { "id": "pct3", "type": "number", "label": "Option 3 (%)", "default": 15, "min": 0, "max": 100, "step": 1, "group": "Options" },
    { "id": "option4", "type": "text", "label": "Option 4 (blank to hide)", "default": "", "maxLength": 32, "group": "Options" },
    { "id": "pct4", "type": "number", "label": "Option 4 (%)", "default": 0, "min": 0, "max": 100, "step": 1, "group": "Options" },
    { "id": "accent", "type": "color", "label": "Bar color", "default": "#e0263c", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#0e1526", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.5, "min": 0.2, "max": 2, "step": 0.1 }
  ]
}
