{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.caption",
  "name": "Newsdesk caption",
  "description": "A quote bar with a slash-cut red edge: the quote in bold, the attribution in spaced capitals.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "callout",
  "tags": ["quote", "caption", "slash"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "quote", "type": "text", "label": "Quote", "default": "We will have answers for residents by the end of the week.", "maxLength": 200 },
    { "id": "attribution", "type": "text", "label": "Attribution", "default": "Dana Okafor, City Hall", "maxLength": 80 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#e0263c", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#0e1526f2", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.4, "min": 0.15, "max": 1.5, "step": 0.05 }
  ]
}
