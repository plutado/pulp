{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.overlay",
  "name": "Newsdesk bug",
  "description": "A corner bug: a slashed red tab and a short label, sliding in and holding in a chosen corner.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "logo-bug",
  "tags": [
    "bug",
    "corner",
    "broadcast"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "label",
      "type": "text",
      "label": "Label",
      "default": "Newsdesk",
      "maxLength": 20,
      "element": "Label"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Tab color",
      "default": "#e0263c",
      "element": "Tab"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Panel color",
      "default": "#0e1526e6",
      "element": "Panel"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#ffffff",
      "element": "Text"
    },
    {
      "id": "corner",
      "type": "select",
      "label": "Corner",
      "default": "top-right",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "element": "Layout and timing"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.35,
      "min": 0.15,
      "max": 1.5,
      "step": 0.05,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "The mark sits in the bug's accent tab, before the label; the tab widens to hold it. With none chosen the bug is as it always was.",
      "box": {
        "x": 0.838,
        "y": 0.067,
        "width": 0.021,
        "height": 0.037
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "label",
      "element": "Logo"
    }
  ]
}
