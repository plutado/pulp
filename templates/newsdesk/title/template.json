{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.title",
  "name": "Newsdesk title",
  "description": "A full-width headline band with a slashed edge slides in under a red kicker tab.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "title",
  "tags": [
    "headline",
    "broadcast",
    "band"
  ],
  "duration": 5,
  "structure": { "holdFrom": 1.47, "holdTo": 3.41 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "kicker",
      "type": "text",
      "label": "Kicker",
      "default": "Breaking",
      "maxLength": 24,
      "element": "Kicker"
    },
    {
      "id": "headline",
      "type": "text",
      "label": "Headline",
      "default": "Council approves transit plan",
      "maxLength": 70,
      "element": "Headline"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent color",
      "default": "#e0263c",
      "element": "Accent"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Band color",
      "default": "#0e1526f2",
      "element": "Band"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#ffffff",
      "element": "Text"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.45,
      "min": 0.15,
      "max": 1.5,
      "step": 0.05,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A mark above the kicker tab, on the same left edge, fading up with the text. With none chosen the title is as it always was.",
      "box": {
        "x": 0.057,
        "y": 0.463,
        "width": 0.05,
        "height": 0.089
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "kicker",
      "element": "Logo"
    }
  ]
}
