{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.title",
  "name": "Newsdesk title",
  "description": "A full-width headline band with a slashed edge slides in under a red kicker tab.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "title",
  "tags": ["headline", "broadcast", "band"],
  "duration": 5,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "kicker", "type": "text", "label": "Kicker", "default": "Breaking", "maxLength": 24 },
    { "id": "headline", "type": "text", "label": "Headline", "default": "Council approves transit plan", "maxLength": 70 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#e0263c", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Band color", "default": "#0e1526f2", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.45, "min": 0.15, "max": 1.5, "step": 0.05 }
  ]
}
