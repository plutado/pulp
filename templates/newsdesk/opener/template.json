{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.opener",
  "name": "Newsdesk opener",
  "description": "A red slash sweeps the frame, then the programme name lands in bold capitals over a navy band with a date tab.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "opener",
  "tags": ["opener", "broadcast", "slash"],
  "duration": 6,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "programme", "type": "text", "label": "Programme", "default": "The Evening Report", "maxLength": 50 },
    { "id": "date", "type": "text", "label": "Date line", "default": "Monday 24 October", "maxLength": 50 },
    { "id": "accent", "type": "color", "label": "Accent color", "default": "#e0263c", "group": "Colors" },
    { "id": "panel", "type": "color", "label": "Panel color", "default": "#0e1526f2", "group": "Colors" },
    { "id": "text", "type": "color", "label": "Text color", "default": "#ffffff", "group": "Colors" },
    { "id": "inOut", "type": "number", "label": "Animate in/out (seconds)", "default": 0.4, "min": 0.15, "max": 1.5, "step": 0.05 }
  ]
}
