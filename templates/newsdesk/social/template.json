{
  "formatVersion": 1,
  "id": "pulp.samples.newsdesk.social",
  "name": "Newsdesk social strip",
  "description": "A thin strip along the bottom with a handle and a hashtag, slashed at both ends, sliding in hard from the left.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "social",
  "tags": [
    "social",
    "handle",
    "slash"
  ],
  "duration": 6,
  "structure": { "holdFrom": 1.55, "holdTo": 4.36 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "handle",
      "type": "text",
      "label": "Handle",
      "default": "@eveningreport",
      "maxLength": 40,
      "element": "Handle"
    },
    {
      "id": "hashtag",
      "type": "text",
      "label": "Hashtag",
      "default": "#EveningReport",
      "maxLength": 40,
      "element": "Hashtag"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent color",
      "default": "#e0263c",
      "element": "Accent"
    },
    {
      "id": "panel",
      "type": "color",
      "label": "Panel color",
      "default": "#0e1526f2",
      "element": "Panel"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#ffffff",
      "element": "Text"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.4,
      "min": 0.15,
      "max": 1.5,
      "step": 0.05,
      "element": "Layout and timing"
    }
  ]
}
