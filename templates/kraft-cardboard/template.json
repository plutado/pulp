{
  "formatVersion": 1,
  "id": "pulp.samples.kraft-cardboard",
  "name": "Kraft cardboard",
  "description": "Brown kraft board with fiber speckle and the faint ribs of corrugation showing through; the angle turns the ribs and the scale sets their spacing.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "background",
  "type": "texture",
  "themes": [
    "food",
    "nonprofit"
  ],
  "styles": [
    "organic",
    "hand-drawn"
  ],
  "tags": [
    "still",
    "kraft",
    "cardboard"
  ],
  "duration": 10,
  "structure": {
    "loop": true
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "base",
      "type": "color",
      "label": "Board color",
      "default": "#b98a5b",
      "element": "Colors"
    },
    {
      "id": "fleck",
      "type": "color",
      "label": "Fleck color",
      "default": "#7a5634",
      "element": "Colors"
    },
    {
      "id": "rib",
      "type": "color",
      "label": "Rib color",
      "default": "#a0744a",
      "element": "Colors"
    },
    {
      "id": "angle",
      "type": "number",
      "label": "Angle (degrees)",
      "default": 90,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
    }
  ]
}
