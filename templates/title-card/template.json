{
  "formatVersion": 1,
  "id": "pulp.samples.title-card",
  "name": "Title Card",
  "description": "Centered title and subtitle that fade and track in over a solid background, with a thin rule between them. The words are layers: add a line and it rides the same fade, in its turn.",
  "version": "1.1.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "tags": ["title", "opener", "minimal"],
  "duration": 5,
  "structure": { "holdFrom": 2.55, "holdTo": 4.05 },
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    { "id": "background", "type": "color", "label": "Background", "default": "#0f172a", "element": "Card" },
    { "id": "rule", "type": "color", "label": "Rule", "default": "#38bdf8", "element": "Card" },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "element": "Logo",
      "description": "A mark centred above the title, fading with it. With none chosen the card is as it always was.",
      "box": { "x": 0.471, "y": 0.266, "width": 0.057, "height": 0.102 },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "title"
    }
  ],
  "blocks": [
    {
      "id": "card",
      "label": "Card",
      "box": {
        "16:9": { "x": 0.07, "y": 0.2892592593, "width": 0.86, "height": 0.4 },
        "9:16": { "x": 0.07, "y": 0.2339583333, "width": 0.86, "height": 0.4 },
        "1:1": { "x": 0.07, "y": 0.2892592593, "width": 0.86, "height": 0.4 },
        "4:5": { "x": 0.07, "y": 0.2914074074, "width": 0.86, "height": 0.4 },
        "default": { "x": 0.07, "y": 0.2892592593, "width": 0.86, "height": 0.4 }
      },
      "gap": 0.0411111111,
      "align": "center",
      "verticalAlign": "middle",
      "open": true,
      "typography": {
        "family": "Georgia, Times New Roman, serif",
        "size": 0.0888888889,
        "weight": 400,
        "color": "#f8fafc",
        "align": "center",
        "lineHeight": 1.1458333333
      },
      "layers": [
        {
          "id": "title",
          "type": "text",
          "label": "Title",
          "text": "Field Notes",
          "required": true,
          "case": "upper",
          "letterSpacing": 0.125,
          "maxLines": 3
        },
        {
          "id": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "text": "Episode 1: Early Light",
          "size": 0.0351851852,
          "italic": true,
          "lineHeight": 1.2,
          "overflow": "shrink"
        }
      ]
    }
  ]
}
