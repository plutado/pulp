{
  "formatVersion": 1,
  "id": "pulp.samples.caution-callout",
  "name": "Caution Chip",
  "description": "A striped hazard chip that drops in with one firm shake, the warning beside it. Points at the step people get wrong.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "callout",
  "tags": [
    "callout",
    "warning",
    "hazard"
  ],
  "themes": [
    "technology",
    "science",
    "business"
  ],
  "styles": [
    "high-energy",
    "clean"
  ],
  "duration": 6,
  "structure": {
    "holdFrom": 1.2,
    "holdTo": 5.2
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "warning",
      "type": "text",
      "label": "Warning",
      "default": "Unplug it first",
      "maxLength": 28,
      "element": "Chip"
    },
    {
      "id": "chip",
      "type": "color",
      "label": "Chip",
      "default": "#fbbf24",
      "element": "Chip"
    },
    {
      "id": "ink",
      "type": "color",
      "label": "Ink",
      "default": "#1c1917",
      "element": "Chip"
    },
    {
      "id": "y",
      "type": "number",
      "label": "Down",
      "default": 0.24,
      "min": 0.1,
      "max": 0.85,
      "element": "Chip"
    }
  ]
}
