    "hexagon",
    "gaming"
  ],
  "themes": [
    "gaming",
    "technology",
    "social-media"
  ],
  "styles": [
    "high-energy",
    "tech"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
