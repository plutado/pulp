        {
          "id": "role",
          "type": "text",
          "label": "Rank",
          "text": "Diamond II \u00b7 Support",
          "size": 0.026,
          "weight": 500,
          "color": "#a5f3fc",
          "family": "Inter"
        }
      ]
    }
  ],
  "parameters": [
    {
