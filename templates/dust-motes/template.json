{
  "formatVersion": 1,
  "id": "pulp.samples.dust-motes",
  "name": "Dust motes",
  "description": "Slow drifting soft motes of varied size over a faint warm haze band, looping through the shot and fading in and out.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "light-particles",
  "themes": ["cinema", "documentary", "nature"],
  "styles": ["cinematic"],
  "tags": ["dust", "motes", "haze"],
  "duration": 10,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "color", "type": "color", "label": "Mote color", "default": "#fff1d6", "group": "Colors" },
    { "id": "amount", "type": "number", "label": "Amount", "default": 70, "min": 10, "max": 200, "step": 5 },
    { "id": "size", "type": "number", "label": "Size", "default": 1, "min": 0.4, "max": 2.5, "step": 0.1 },
    { "id": "drift", "type": "number", "label": "Drift", "default": 1, "min": 0.2, "max": 3, "step": 0.1 },
    { "id": "haze", "type": "number", "label": "Haze", "default": 0.35, "min": 0, "max": 1, "step": 0.05 },
    { "id": "inOut", "type": "number", "label": "Fade in/out (seconds)", "default": 1.5, "min": 0.2, "max": 2, "step": 0.1 }
  ]
}
