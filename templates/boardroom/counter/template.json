{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.counter",
  "name": "Boardroom counter",
  "description": "A large figure counting from a start to a target value on an eased curve, with prefix, suffix, a label beneath and a hairline above.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "counter",
  "tags": [
    "number",
    "statistic",
    "count up"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "start",
      "type": "number",
      "label": "Start value",
      "default": 0,
      "min": -1000000000,
      "max": 1000000000,
      "step": 0.01,
      "element": "Figures"
    },
    {
      "id": "target",
      "type": "number",
      "label": "Target value",
      "default": 128.4,
      "min": -1000000000,
      "max": 1000000000,
      "step": 0.01,
      "element": "Figures"
    },
    {
      "id": "decimals",
      "type": "number",
      "label": "Decimals",
      "default": 1,
      "min": 0,
      "max": 3,
      "step": 1,
      "element": "Figures"
    },
    {
      "id": "prefix",
      "type": "text",
      "label": "Prefix",
      "default": "$",
      "maxLength": 6,
      "element": "Figures"
    },
    {
      "id": "suffix",
      "type": "text",
      "label": "Suffix",
      "default": "M",
      "maxLength": 6,
      "element": "Figures"
    },
    {
      "id": "label",
      "type": "text",
      "label": "Label",
      "default": "Annual recurring revenue",
      "maxLength": 60,
      "element": "Label"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent color",
      "default": "#4f7cac",
      "element": "Accent"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#f4f6f9",
      "element": "Text"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.8,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
