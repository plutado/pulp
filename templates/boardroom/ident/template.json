{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.ident",
  "name": "Boardroom ident",
  "description": "A hairline rule draws in from the centre, the logo rises up through it and settles, and the rule fades away.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "title",
  "type": "logo-reveal",
  "tags": [
    "ident",
    "logo",
    "hairline"
  ],
  "duration": 2.5,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": false,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "default": "Northwind Holdings",
      "maxLength": 60,
      "description": "Set in type where the logo would be when no logo is chosen.",
      "element": "Name"
    },
    {
      "id": "ground",
      "type": "color",
      "label": "Ground color",
      "default": "#16233a",
      "element": "Ground"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent color",
      "default": "#4f7cac",
      "element": "Accent"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#f4f6f9",
      "element": "Text"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "Rises through the rule and settles at the centre; with none chosen the name stands in as a wordmark.",
      "box": {
        "x": 0.37,
        "y": 0.35,
        "width": 0.26,
        "height": 0.3
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name",
      "element": "Logo"
    }
  ]
}
