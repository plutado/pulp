{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.arrow",
  "name": "Boardroom arrow",
  "description": "A hairline arrow that draws from a start point to an end point with a small square head and an optional spaced-capitals label.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "arrows",
  "tags": [
    "arrow",
    "pointer",
    "hairline"
  ],
  "duration": 5,
  "structure": { "holdFrom": 2.15, "holdTo": 2.85 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "label",
      "type": "text",
      "label": "Label",
      "default": "Q3 forecast",
      "maxLength": 40,
      "element": "Label"
    },
    {
      "id": "x1",
      "type": "number",
      "label": "Start X (% of width)",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "element": "Layout and timing"
    },
    {
      "id": "y1",
      "type": "number",
      "label": "Start Y (% of height)",
      "default": 70,
      "min": 0,
      "max": 100,
      "step": 1,
      "element": "Layout and timing"
    },
    {
      "id": "x2",
      "type": "number",
      "label": "End X (% of width)",
      "default": 62,
      "min": 0,
      "max": 100,
      "step": 1,
      "element": "Layout and timing"
    },
    {
      "id": "y2",
      "type": "number",
      "label": "End Y (% of height)",
      "default": 38,
      "min": 0,
      "max": 100,
      "step": 1,
      "element": "Layout and timing"
    },
    {
      "id": "line",
      "type": "color",
      "label": "Line color",
      "default": "#4f7cac",
      "element": "Line"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Label color",
      "default": "#f4f6f9",
      "element": "Label"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.9,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
