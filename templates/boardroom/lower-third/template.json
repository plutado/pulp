{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.lower-third",
  "name": "Boardroom lower third",
  "description": "Name over a hairline rule that draws in, with a small accent square; quiet and corporate.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "lower-third",
  "type": "lower-third",
  "tags": [
    "name",
    "interview",
    "hairline"
  ],
  "duration": 6,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "default": "Morgan Hale",
      "maxLength": 60,
      "element": "Name"
    },
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "Chief Operating Officer",
      "maxLength": 80,
      "element": "Title"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent color",
      "default": "#4f7cac",
      "element": "Accent"
    },
    {
      "id": "text",
      "type": "color",
      "label": "Text color",
      "default": "#f4f6f9",
      "element": "Text"
    },
    {
      "id": "shadow",
      "type": "color",
      "label": "Backing tint",
      "default": "#10182833",
      "element": "Backing"
    },
    {
      "id": "side",
      "type": "select",
      "label": "Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Bottom left"
        },
        {
          "value": "right",
          "label": "Bottom right"
        }
      ],
      "element": "Layout and timing"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.7,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    },
    {
      "id": "logo",
      "type": "image",
      "label": "Logo",
      "description": "A badge at the head of the text block, left of the name; the hairline and backing tint grow to include it. With none chosen the piece is as it always was.",
      "box": {
        "x": 0.057,
        "y": 0.794,
        "width": 0.056,
        "height": 0.099
      },
      "fit": "contain",
      "align": "center",
      "margin": 0.1,
      "fallbackText": "name",
      "element": "Logo"
    }
  ]
}
