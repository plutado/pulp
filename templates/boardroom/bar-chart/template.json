{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.bar-chart",
  "name": "Boardroom bar chart",
  "description": "A title over up to five hairline bars that grow in one after another while their values count up.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "infographic",
  "tags": [
    "chart",
    "bars",
    "data"
  ],
  "duration": 7,
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "Revenue by region",
      "maxLength": 60,
      "element": "Title"
    },
    {
      "id": "label1",
      "type": "text",
      "label": "Bar 1 label",
      "default": "North America",
      "maxLength": 32,
      "element": "Bar 1"
    },
    {
      "id": "value1",
      "type": "number",
      "label": "Bar 1 value",
      "default": 42,
      "min": 0,
      "max": 1000000,
      "step": 0.1,
      "element": "Bar 1"
    },
    {
      "id": "label2",
      "type": "text",
      "label": "Bar 2 label",
      "default": "Europe",
      "maxLength": 32,
      "element": "Bar 2"
    },
    {
      "id": "value2",
      "type": "number",
      "label": "Bar 2 value",
      "default": 31,
      "min": 0,
      "max": 1000000,
      "step": 0.1,
      "element": "Bar 2"
    },
    {
      "id": "label3",
      "type": "text",
      "label": "Bar 3 label",
      "default": "Asia Pacific",
      "maxLength": 32,
      "element": "Bar 3"
    },
    {
      "id": "value3",
      "type": "number",
      "label": "Bar 3 value",
      "default": 27,
      "min": 0,
      "max": 1000000,
      "step": 0.1,
      "element": "Bar 3"
    },
    {
      "id": "label4",
      "type": "text",
      "label": "Bar 4 label",
      "default": "Latin America",
      "maxLength": 32,
      "element": "Bar 4"
    },
    {
      "id": "value4",
      "type": "number",
      "label": "Bar 4 value",
      "default": 12,
      "min": 0,
      "max": 1000000,
      "step": 0.1,
      "element": "Bar 4"
    },
    {
      "id": "label5",
      "type": "text",
      "label": "Bar 5 label (blank to hide)",
      "default": "",
      "maxLength": 32,
      "element": "Bar 5"
    },
    {
      "id": "value5",
      "type": "number",
      "label": "Bar 5 value",
      "default": 0,
      "min": 0,
      "max": 1000000,
      "step": 0.1,
      "element": "Bar 5"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.8,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
