{
  "formatVersion": 1,
  "id": "pulp.samples.boardroom.overlay",
  "name": "Boardroom frame",
  "description": "A thin margin frame with corner ticks that draws itself in from the corners and holds.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "frame",
  "tags": [
    "frame",
    "border",
    "corners"
  ],
  "duration": 6,
  "structure": { "holdFrom": 0.99, "holdTo": 5.01 },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "line",
      "type": "color",
      "label": "Line color",
      "default": "#f4f6f9cc",
      "element": "Line"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Corner color",
      "default": "#4f7cac",
      "element": "Corner"
    },
    {
      "id": "margin",
      "type": "number",
      "label": "Margin (px at 1080p)",
      "default": 64,
      "min": 24,
      "max": 160,
      "step": 4,
      "element": "Layout and timing"
    },
    {
      "id": "weight",
      "type": "number",
      "label": "Line weight",
      "default": 2,
      "min": 1,
      "max": 8,
      "step": 1,
      "element": "Line"
    },
    {
      "id": "inOut",
      "type": "number",
      "label": "Animate in/out (seconds)",
      "default": 0.8,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "element": "Layout and timing"
    }
  ]
}
