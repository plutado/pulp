{
  "formatVersion": 1,
  "id": "pulp.samples.jack-o-lantern",
  "name": "Jack-o’-lantern",
  "description": "A carved pumpkin with a lit grin, popping in.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "holiday-objects",
  "themes": [
    "halloween",
    "holiday"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "holiday"
  ],
  "duration": 5,
  "structure": {
    "holdFrom": 0.8,
    "holdTo": 4.4
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "pumpkin",
      "type": "color",
      "label": "Pumpkin color",
      "default": "#f77f00",
      "element": "Colors"
    },
    {
      "id": "glow",
      "type": "color",
      "label": "Glow color",
      "default": "#ffd166",
      "element": "Colors"
    },
    {
      "id": "entrance",
      "type": "select",
      "label": "Entrance",
      "default": "pop",
      "element": "Entrance",
      "options": [
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "drop",
          "label": "Drop"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "draw",
          "label": "Draw on"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    }
  ]
}
