{
  "formatVersion": 1,
  "id": "pulp.samples.heart-in-hands",
  "name": "Heart in hands",
  "description": "A heart held up in two open hands, rising into place.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "community-objects",
  "themes": [
    "nonprofit",
    "civic"
  ],
  "styles": [
    "clean",
    "playful"
  ],
  "tags": [
    "object",
    "prop",
    "community"
  ],
