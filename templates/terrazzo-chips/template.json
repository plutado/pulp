      "label": "Angle (degrees)",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1,
      "element": "Pattern"
    },
    {
      "id": "scale",
      "type": "number",
      "label": "Pattern scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "element": "Pattern"
    },
    {
      "id": "grain",
      "type": "number",
      "label": "Grain",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "element": "Grain"
