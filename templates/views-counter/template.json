{
  "formatVersion": 1,
  "id": "pulp.samples.views-counter",
  "name": "View Count",
  "description": "A figure that counts up to its total beside a small rising arrow, the unit beneath. Shows a reach milestone for a channel or a campaign.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "other",
  "type": "counter",
  "tags": [
    "counter",
    "views",
    "growth"
  ],
  "themes": [
    "social-media",
    "media",
    "business"
  ],
  "styles": [
    "clean",
    "tech"
  ],
  "duration": 6,
  "structure": {
    "holdFrom": 2.1,
    "holdTo": 5.2
  },
  "fps": 30,
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    {
      "id": "target",
      "type": "number",
      "label": "Total",
      "default": 1250000,
      "min": 0,
      "max": 999999999,
      "element": "Figure"
    },
    {
      "id": "unit",
      "type": "text",
      "label": "Unit",
      "default": "views this month",
      "maxLength": 30,
      "element": "Figure"
    },
    {
      "id": "ink",
      "type": "color",
      "label": "Figure",
      "default": "#f8fafc",
      "element": "Figure"
    },
    {
      "id": "up",
      "type": "color",
      "label": "Arrow",
      "default": "#4ade80",
      "element": "Figure"
    }
  ]
}
