{
  "formatVersion": 1,
  "id": "pulp.samples.scratches",
  "name": "Scratches",
  "description": "Thin vertical scratches that appear and vanish over a few frames, with the occasional hair and dust fleck, like a worn print.",
  "version": "1.0.0",
  "author": "David Fugate",
  "license": "CC0-1.0",
  "category": "overlay",
  "type": "film-grunge",
  "themes": ["cinema", "documentary"],
  "styles": ["grunge"],
  "tags": ["scratches", "film", "dust"],
  "duration": 8,
  "fps": 30,
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "alpha": true,
  "entry": "index.html",
  "parameters": [
    { "id": "color", "type": "color", "label": "Scratch color", "default": "#f3ecdc", "group": "Colors" },
    { "id": "amount", "type": "number", "label": "Amount", "default": 6, "min": 1, "max": 20, "step": 1 },
    { "id": "length", "type": "number", "label": "Length", "default": 0.7, "min": 0.1, "max": 1, "step": 0.05 },
    { "id": "dust", "type": "number", "label": "Dust", "default": 0.5, "min": 0, "max": 1, "step": 0.05 },
    { "id": "inOut", "type": "number", "label": "Fade in/out (seconds)", "default": 0.5, "min": 0.2, "max": 2, "step": 0.1 }
  ]
}
